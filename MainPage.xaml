<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CzytaniePliku.MainPage"
             BackgroundColor="LightGreen"
             >

    <ScrollView>
        <HorizontalStackLayout
            Padding="30,0"
            Spacing="25"
            
            HorizontalOptions="Center">
            <!-- Wstacz -->
            <ImageButton 
                Source="dotnet_bot.png"
                x:Name="WstaczButton"
                Clicked="OnWstaczButtonClicked"
                WidthRequest="50"
                BackgroundColor="LightGreen"
                 />
            <VerticalStackLayout
                WidthRequest="900"
                HeightRequest="200">
                <HorizontalStackLayout>
                    <!-- Płyta -->
                    <Image
                        Source="dotnet_bot.png"
                        HeightRequest="100"
                        Aspect="AspectFit"
                        SemanticProperties.Description="dot net bot" />
                    <VerticalStackLayout>
                        <Label
                            Text="Kapela"
                            x:Name="ArtistLabel"
                            FontSize="50" />
                        <Label
                            Text="Album"
                            x:Name="AlbumLabel"
                            FontSize="30" />
                        <Label
                            Text="xx utworów       1992"
                            x:Name="IleKiedyLabel"
                            TextColor="green"
                            FontSize="20"/>
                    </VerticalStackLayout>

                </HorizontalStackLayout>
                <HorizontalStackLayout
                    Spacing="20"
                    Padding="0,20"
                    >
                    <Label
                        Text=":::"
                        x:Name="DownloadLabel"
                        TextColor="green"
                        SemanticProperties.Description="Ilość pobrań" 
                        VerticalOptions="Center"
                        />
                    <Button 
                        Text="Pobierz"
                        x:Name="PobierzBtn"
                        BackgroundColor="green"
                        Padding="15,0"
                        FontSize="20"
                        Clicked="OnPobierzBtnClicked"
                        />
                    <Label
                        Text="::::::::::::::::::"
                        x:Name="SomeLabel"
                        TextColor="Grey"
                        />
                </HorizontalStackLayout>
            </VerticalStackLayout>
            <!-- Dalej -->
            <ImageButton 
                Source="dotnet_bot.png"
                x:Name="DalejButton"
                Clicked="OnDalejButtonClicked"
                WidthRequest="50"
                BackgroundColor="LightGreen"
                 />
        </HorizontalStackLayout>
    </ScrollView>

</ContentPage>
